---
import Base from "../layouts/Base.astro"
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/")
---

<Base title="Now">
  <h1>Now</h1>
  <p class="lede">
    The current season at a glance. (Prototype: this will be a handful of
    tools at preset settings.)
  </p>
  <ul class="cards">
    <li><a href={`${base}playoffs`}><strong>Playoff net points</strong><span>Every player's net points in every playoff game, by team</span></a></li>
  </ul>
</Base>
