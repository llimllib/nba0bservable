---
import Base from "../layouts/Base.astro"
import { catalog } from "../tools/catalog"
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/")
const [lead, ...rest] = catalog
---

<Base title="Now">
  <article class="lead">
    <h2><a href={`${base}${lead.href}`}>{lead.name}</a></h2>
    <p class="lede">{lead.blurb}</p>
  </article>
  <div class="columns">
    {rest.map(t => (
      <article>
        <h2><a href={`${base}${t.href}`}>{t.name}</a></h2>
        <p>{t.blurb}</p>
      </article>
    ))}
  </div>
</Base>
