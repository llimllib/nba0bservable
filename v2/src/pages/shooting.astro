---
import Base from "../layouts/Base.astro"
---

<Base title="Shooting by usage" description="True shooting against usage rate for the players who take the most shots">
  <h1>Shooting by usage</h1>
  <p class="lede">
    Each dot is a player: how much of his team's offense he uses, and how
    efficiently he scores. The dashed lines are league average.
  </p>
  <div id="tool"></div>
</Base>

<script>
  import { mount } from "../kit/mount"
  import { shooting } from "../tools/shooting"
  mount(document.getElementById("tool")!, shooting)
</script>
