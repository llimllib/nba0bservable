---
import "../styles/global.css"

interface Props {
  title: string
  description?: string
}
const { title, description } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/")
const path = Astro.url.pathname
const nav = [
  { href: base, label: "Now" },
  { href: `${base}tools`, label: "Tools" },
  { href: `${base}notes`, label: "Notes" },
]
const fonts = `
@font-face { font-family: Inter; font-weight: 100 900; font-display: swap; src: url(${base}fonts/inter.woff2) format("woff2"); }
@font-face { font-family: Caveat; font-weight: 600; font-display: swap; src: url(${base}fonts/caveat.woff2) format("woff2"); }`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Step Back Club</title>
    {description && <meta name="description" content={description} />}
    <link rel="preload" href={`${base}fonts/inter.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}fonts/caveat.woff2`} as="font" type="font/woff2" crossorigin />
    <style set:html={fonts}></style>
  </head>
  <body>
    <header class="site">
      <a class="wordmark" href={base}>Step Back Club</a>
      <nav>
        {nav.map(n => (
          <a href={n.href} aria-current={path === n.href || (n.href !== base && path.startsWith(n.href)) ? "page" : undefined}>
            {n.label}
          </a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
