---
import "../styles/global.css"
import { fontFace, fontFiles } from "../kit/theme"

interface Props {
  title: string
  description?: string
}
const { title, description } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/")
const path = Astro.url.pathname
const nav = [
  { href: base, label: "Now" },
  { href: `${base}scores`, label: "Scores" },
  { href: `${base}tools`, label: "Tools" },
  { href: `${base}notes`, label: "Notes" },
]
const fonts = fontFiles.map(f => fontFace(f, base + f.url)).join("\n")
// the latin subsets of the faces every page sets above the fold
const preload = fontFiles.filter(
  f =>
    f.range &&
    !f.url.includes("-ext") &&
    (f.url.includes("700") || f.url.includes("mono") || f.url.endsWith("source-serif-4.woff2")),
)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Step Back Club</title>
    {description && <meta name="description" content={description} />}
    {preload.map(f => <link rel="preload" href={base + f.url} as="font" type="font/woff2" crossorigin />)}
    <style set:html={fonts}></style>
  </head>
  <body>
    <header class="masthead">
      <div class="nameplate">
        <a class="wordmark" href={base}>Step Back Club</a>
        <nav>
          {nav.map(n => (
            <a href={n.href} aria-current={path === n.href || (n.href !== base && path.startsWith(n.href)) ? "page" : undefined}>
              {n.label}
            </a>
          ))}
        </nav>
      </div>
      <p class="dateline"><span class="today"></span><span class="season"></span><span class="updated"></span></p>
    </header>
    <main>
      <slot />
    </main>
    <footer class="colophon">Data: NBA.com · ESPN Analytics · billmill.org/nba</footer>
    <script>
      import { metadata } from "../kit/data"

      // the dateline is filled in on the reader's day, not the build's
      const now = new Date()
      document.querySelector(".dateline .today")!.textContent =
        now.toLocaleDateString("en-US", {
          weekday: "short",
          month: "short",
          day: "numeric",
          year: "numeric",
        })
      // seasons start in October
      const y = now.getMonth() >= 9 ? now.getFullYear() : now.getFullYear() - 1
      document.querySelector(".dateline .season")!.textContent =
        `${y}–${String(y + 1).slice(2)} season`
      // when the data last changed. Left blank if the catalog can't be read
      metadata().then(m => {
        const last = Object.values(m)
          .map(d => d.updated)
          .sort()
          .at(-1)
        if (last)
          document.querySelector(".dateline .updated")!.textContent =
            `Updated ${new Date(last).toLocaleDateString("en-US", { month: "short", day: "numeric" })}`
      }, () => {})
    </script>
  </body>
</html>
