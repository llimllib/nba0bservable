---
import Base from "../layouts/Base.astro"
---

<Base title="Player charts" description="One player stat against another: shooting, playmaking, rebounding, defense, and offense against defense in net points, RAPM and EPM">
  <h1>Player charts</h1>
  <p class="lede">
    Each dot is a player, placed by two stats. Pick the pair; the dashed
    lines are the league's average, or for offense against defense, zero
    is.
  </p>
  <div id="tool"></div>
</Base>

<script>
  import { mount } from "../kit/mount"
  import { scatter } from "../tools/scatter"
  mount(document.getElementById("tool")!, scatter)
</script>
