---
import Base from "../layouts/Base.astro"
import { catalog } from "../tools/catalog"
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/")
---

<Base title="Tools">
  <h1>Tools</h1>
  <p class="lede">Make a chart, annotate it, export it.</p>
  <ul class="index">
    {catalog.map(t => (
      <li>
        <h2><a href={`${base}${t.href}`}>{t.name}</a></h2>
        <p>{t.blurb}</p>
        <span class="takes">{t.takes.join(" · ")}</span>
      </li>
    ))}
  </ul>
</Base>
