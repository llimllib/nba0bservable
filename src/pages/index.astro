---
import Base from "../layouts/Base.astro"
import { catalog } from "../tools/catalog"
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/")
const lead = catalog.find(t => t.href === "shooting")!
// playoff net points joins them, as the lead, once there are playoffs
const briefs = ["efficiency", "cumulative", "rotations"].map(
  href => catalog.find(t => t.href === href)!,
)
---

<Base title="Now">
  <div class="front">
    <figure class="lead">
      <a class="inset" href={`${base}${lead.href}`} aria-label={lead.name}><div id="lead-chart"></div></a>
      <figcaption>
        <p>
          <b class="where"><span class="wide">Right</span><span class="narrow">Above</span>:</b>{" "}
          <span id="lead-caption">{lead.blurb}</span>
        </p>
        <p class="aside">
          Higher is more efficient; further right uses more of the offense.
          The dashed lines are league average.
        </p>
        <a class="more" href={`${base}${lead.href}`}>Make your own →</a>
        <aside class="about">
          <span class="kicker">About</span>
          <p>
            Every chart here is a tool: change the season or the team, label
            it, and export it as an image to post.
          </p>
        </aside>
        <aside class="about board">
          <span class="kicker" id="board-day">Scores</span>
          <ul id="board" hidden></ul>
          <p>Every game of the night, with the four factors and how the winner won.</p>
          <a class="more" href={`${base}scores`}>Box scores →</a>
        </aside>
      </figcaption>
    </figure>
    <section class="briefs" aria-label="More tools">
      {briefs.map(t => (
        <article>
          <span class="kicker">{t.name}</span>
          <h2><a id={`brief-${t.href}`} href={`${base}${t.href}`}>{t.hook}</a></h2>
          <p>{t.pitch}</p>
          <a class="more" href={`${base}${t.href}`}>{t.takes.join(" · ")} →</a>
        </article>
      ))}
    </section>
  </div>
</Base>

<script>
  import { embed } from "../kit/mount"
  import { leaders, shooting } from "../tools/shooting"
  import {
    cumulativeBrief,
    efficiencyBrief,
    rotationsBrief,
    type Brief,
  } from "../tools/briefs"
  import { latestNight } from "../scores/load"

  const pct = (v: number) => `${(v * 100).toFixed(1)}%`
  const { data, p } = await embed(document.getElementById("lead-chart")!, shooting)
  const { usage, efficient, games } = leaders(data, p)
  // the caption states what the chart shows today
  if (usage && efficient)
    document.getElementById("lead-caption")!.textContent =
      `${games} games in, ${usage.name} is using ${pct(usage.usg)} of ` +
      `${usage.team}'s possessions while he's on the floor, the most in the ` +
      `league. Of the players carrying more than an average load, ` +
      `${efficient.name} (${efficient.team}) is scoring most efficiently, ` +
      `at ${pct(efficient.ts)} true shooting.`

  // then each brief's headline, after the lead so it doesn't slow the chart.
  // One that fails keeps its standing headline
  const briefs: [string, () => Promise<Brief | undefined>][] = [
    ["efficiency", efficiencyBrief],
    ["cumulative", cumulativeBrief],
    ["rotations", rotationsBrief],
  ]
  // last night's scores, under the caption
  latestNight()
    .then(({ yesterday, date, games }) => {
      if (games.length === 0) return
      const day =
        date === yesterday
          ? "Last night"
          : new Date(`${date}T12:00:00Z`).toLocaleDateString("en-US", {
              timeZone: "UTC",
              weekday: "short",
              month: "short",
              day: "numeric",
            })
      document.getElementById("board-day")!.textContent = `Scores · ${day}`
      const board = document.getElementById("board")!
      board.replaceChildren(
        ...games.map(g => {
          const [w, l] = g.teams
          // padded, so the columns of the monospaced lines align
          const pts = (n: number) => String(n).padStart(3)
          const li = document.createElement("li")
          const b = document.createElement("b")
          b.textContent = `${w.abbrev} ${pts(w.pts)}`
          li.append(b, ` ${l.abbrev} ${pts(l.pts)}`)
          if (g.status !== "Final") {
            const ot = document.createElement("span")
            ot.textContent = ` ${g.status.replace("Final/", "")}`
            li.append(ot)
          }
          return li
        }),
      )
      board.hidden = false
    })
    .catch(e => console.error(e))

  for (const [id, brief] of briefs)
    brief()
      .then(b => {
        const a = document.getElementById(`brief-${id}`) as HTMLAnchorElement
        if (!b || !a) return
        a.textContent = b.headline
        if (b.query) a.search = b.query
      })
      .catch(e => console.error(e))
</script>
